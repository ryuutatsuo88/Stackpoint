# Required: an Anthropic API key with access to Claude.
# Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Optional: override the default provider/model.
# Supported providers: claude (default), openai (stub)
LLM_PROVIDER=claude
LLM_MODEL=claude-opus-4-7

# Optional: where the extractor writes structured output that the web app reads.
EXTRACTOR_OUTPUT_DIR=apps/web/data/output
